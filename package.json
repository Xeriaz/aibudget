{
  "name": "aibudgetpwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run test:run && BASE_PATH=/aibudget/ npm run build && bash -c 'set -euo pipefail; TMP_DIR=$(mktemp -d); trap \"git worktree remove --force \\\"$TMP_DIR\\\" 2>/dev/null || rm -rf \\\"$TMP_DIR\\\"\" EXIT; git worktree add --detach \"$TMP_DIR\"; cp -R dist/. \"$TMP_DIR/\"; cd \"$TMP_DIR\"; git add -f dist 2>/dev/null || true; git add -A; git commit -m \"Deploy update\"; git push origin HEAD:refs/heads/gh-pages --force'"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "i18next": "^26.5.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.9",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.5",
    "workbox-window": "^7.3.0"
  }
}
